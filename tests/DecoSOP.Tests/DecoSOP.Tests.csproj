<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Keep this project out of solution-level publish. CI runs "dotnet publish" from the
         repo root, which would otherwise drop test assemblies into the installer payload. -->
    <IsPublishable>false</IsPublishable>
    <!-- The app pins win-x64/self-contained; tests only need to run on the build agent. -->
    <RuntimeIdentifier></RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <!-- The app is self-contained, so the SDK prunes NPOI's vulnerable transitive
         System.Security.Cryptography.Xml 8.0.2 in favour of the runtime's patched copy. This
         project is framework-dependent, where that pruning does not apply, so pin it directly.
         Safe here precisely because this project is never published. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DecoSOP.csproj" />
  </ItemGroup>

</Project>
