@* Small glyph identifying a file's type at a glance. Colours deliberately match the existing
   .file-type-badge palette in app.css, so the icon and the text badge agree. Shapes differ by
   family rather than by extension — a spreadsheet reads as a grid, a document as lines of text
   — because at this size colour alone is not enough to tell them apart. *@

<span class="file-type-icon fti-@Kind" title="@Title" aria-hidden="true">
    @switch (Kind)
    {
        case "sheet":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <path d="M3 9.5h18M3 14.5h18M9.5 9.5V20M15 9.5V20" />
            </svg>
            break;

        case "word":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <path d="M14 3v5h5" />
                <path d="M8.5 13h7M8.5 16.5h4.5" />
            </svg>
            break;

        case "pdf":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <path d="M14 3v5h5" />
                <rect x="7.5" y="12.5" width="9" height="5" rx="1.2" fill="currentColor" stroke="none" />
            </svg>
            break;

        case "slides":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="12" rx="2" />
                <path d="M12 16v4M8.5 20h7" />
            </svg>
            break;

        case "image":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <circle cx="8.5" cy="9.5" r="1.6" />
                <path d="M3.5 17.5l4.5-4.5 3 3 4-4 5.5 5.5" />
            </svg>
            break;

        case "archive":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2" />
                <path d="M12 4.5v3M12 9.5v2M12 13.5v2" />
            </svg>
            break;

        case "text":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <path d="M14 3v5h5" />
                <path d="M8.5 12.5h7M8.5 15.5h7M8.5 18h4" />
            </svg>
            break;

        default:
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <path d="M14 3v5h5" />
            </svg>
            break;
    }
</span>

@code {
    /// <summary>File name or extension. Either "report.xlsx", ".xlsx" or "xlsx" works.</summary>
    [Parameter] public string? FileName { get; set; }

    private string Extension =>
        (Path.GetExtension(FileName ?? string.Empty) is { Length: > 0 } ext
            ? ext
            : "." + (FileName ?? string.Empty))
        .TrimStart('.').ToLowerInvariant();

    private string Kind => Extension switch
    {
        "xls" or "xlsx" or "xlsm" or "xlsb" or "ods" or "csv" => "sheet",
        "doc" or "docx" or "docm" or "odt" or "rtf" or "wps" => "word",
        "pdf" => "pdf",
        "ppt" or "pptx" or "odp" => "slides",
        "png" or "jpg" or "jpeg" or "gif" or "bmp" or "tif" or "tiff" or "webp" => "image",
        "zip" or "7z" or "rar" => "archive",
        "txt" or "md" or "log" => "text",
        _ => "other",
    };

    private string Title => Kind switch
    {
        "sheet" => "Spreadsheet",
        "word" => "Word document",
        "pdf" => "PDF",
        "slides" => "Presentation",
        "image" => "Image",
        "archive" => "Archive",
        "text" => "Text file",
        _ => "File",
    };
}
