@using DecoSOP.Services
@using DecoSOP.Services.Search
@using DecoSOP.Models
@inject DataCacheService Cache
@inject SopFileService SopFileService
@inject DocumentService DocService
@inject InventoryService InvService
@inject NavigationManager Nav
@inject ContextMenuState MenuState
@inject UserPreferenceService Prefs
@inject SyncNotificationService SyncNotify
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="icon.svg" alt="" width="30" height="30" style="margin-right: 0.5rem;" />DecoSOP
        </a>
        <a class="btn-favorites-header" href="favorites" title="All Favorites">&#9733;</a>
    </div>
</div>

<div class="mode-toggle px-3 py-2" data-mode="@currentMode">
    <button class="mode-toggle-btn @(currentMode == "sop" ? "active" : "")" @onclick="@(() => SwitchMode("sop"))">SOPs</button>
    <button class="mode-toggle-btn @(currentMode == "doc" ? "active" : "")" @onclick="@(() => SwitchMode("doc"))">Docs</button>
    <button class="mode-toggle-btn @(currentMode == "inv" ? "active" : "")" @onclick="@(() => SwitchMode("inv"))">Inventory</button>
</div>

<div class="sidebar-content">
    @* Above the mode split: searching is the one thing that should work from anywhere,
       including Favorites, where there is otherwise no way to reach it. *@
    <div class="sidebar-search px-3 py-2">
        <input type="text" class="form-control form-control-sm" aria-label="Search SOPs and documents"
               placeholder="@searchPlaceholder"
               @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchChanged" @onkeyup="OnSearchKeyUp" />
    </div>

    @if (currentMode == "favorites")
    {
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="favorites" Match="NavLinkMatch.All">
                    &#9733; All Favorites
                </NavLink>
            </div>

            @if (!_favoritesLoaded)
            {
                @foreach (var w in skeletonWidths)
                {
                    <div class="nav-item px-3">
                        <div class="skeleton-line sidebar-skeleton" style="width:@(w)%;"></div>
                    </div>
                }
            }
            else
            {
                @if (sopFavoriteCategories.Count > 0 || sopFavoriteDocuments.Count > 0)
                {
                    <div class="nav-section px-3">
                        <span class="nav-section-toggle" style="cursor:default;">
                            <span class="nav-section-title">SOPs</span>
                        </span>
                    </div>
                    @foreach (var cat in sopFavoriteCategories)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"sops/category/{cat.Id}")">
                                <FolderIcon Color="@GetSopCatColor(cat.Id)" />@cat.Name
                                <span class="nav-category-hint">folder</span>
                            </NavLink>
                        </div>
                    }
                    @foreach (var doc in sopFavoriteDocuments)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"sops/{doc.Id}")">
                                @doc.Title
                                <span class="nav-category-hint">@doc.Category.Name</span>
                            </NavLink>
                        </div>
                    }
                }

                @if (docFavoriteCategories.Count > 0 || docFavoriteDocuments.Count > 0)
                {
                    <div class="nav-section px-3">
                        <span class="nav-section-toggle" style="cursor:default;">
                            <span class="nav-section-title">Documents</span>
                        </span>
                    </div>
                    @foreach (var cat in docFavoriteCategories)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"documents/category/{cat.Id}")">
                                <FolderIcon Color="@GetDocCatColor(cat.Id)" />@cat.Name
                                <span class="nav-category-hint">folder</span>
                            </NavLink>
                        </div>
                    }
                    @foreach (var doc in docFavoriteDocuments)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"documents/{doc.Id}")">
                                @doc.Title
                                <span class="nav-category-hint">@doc.Category.Name</span>
                            </NavLink>
                        </div>
                    }
                }

                @if (invFavoriteCategories.Count > 0 || invFavoriteItems.Count > 0)
                {
                    <div class="nav-section px-3">
                        <span class="nav-section-toggle" style="cursor:default;">
                            <span class="nav-section-title">Inventory</span>
                        </span>
                    </div>
                    @foreach (var cat in invFavoriteCategories)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"inventory/category/{cat.Id}")">
                                <FolderIcon Color="@GetInvCatColor(cat.Id)" />@cat.Name
                                <span class="nav-category-hint">folder</span>
                            </NavLink>
                        </div>
                    }
                    @foreach (var item in invFavoriteItems)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"inventory?sel={item.Id}")">
                                @item.Title
                                <span class="nav-category-hint">@item.Category?.Name</span>
                            </NavLink>
                        </div>
                    }
                }

                @if (sopFavoriteCategories.Count == 0 && sopFavoriteDocuments.Count == 0
                  && docFavoriteCategories.Count == 0 && docFavoriteDocuments.Count == 0
                  && invFavoriteCategories.Count == 0 && invFavoriteItems.Count == 0)
                {
                    <div class="px-3 py-2 text-muted small">No favorites yet.</div>
                }
            }
        </nav>
    }
    else
    {
    @* Inventory still answers in the sidebar; it has no main-view results surface of its own.
       SOP and Document searching now renders in the main view, so the folder tree below stays
       put and you never lose your place in it while searching. *@
    @if (isSearching && currentMode == "inv")
    {
        <div class="nav-section px-3 py-1">
            <span class="nav-section-title">Search Results</span>
        </div>

        @foreach (var item in invSearchResults)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"inventory?sel={item.Id}")">
                    @item.Title
                    <span class="nav-category-hint">@item.Category?.Name</span>
                </NavLink>
            </div>
        }
        @if (invSearchResults.Count == 0)
        {
            <div class="px-3 py-2 text-muted small">No results found.</div>
        }
    }
    else
    {
        @* --- Favorites --- *@
        @if (hasFavorites)
        {
            <div class="nav-section px-3">
                <button class="nav-section-toggle" @onclick="() => favoritesExpanded = !favoritesExpanded">
                    <span class="toggle-icon">@(favoritesExpanded ? "▾" : "▸")</span>
                    <span class="nav-section-title">&#9733; Favorites</span>
                    <span class="nav-section-count">@favoritesCount</span>
                </button>
            </div>

            @if (favoritesExpanded)
            {
                @if (currentMode == "doc")
                {
                    @foreach (var cat in docFavoriteCategories)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"documents/category/{cat.Id}")">
                                <FolderIcon Color="@GetDocCatColor(cat.Id)" />@cat.Name
                                <span class="nav-category-hint">folder</span>
                            </NavLink>
                        </div>
                    }
                    @foreach (var doc in docFavoriteDocuments)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"documents/{doc.Id}")">
                                @doc.Title
                                <span class="nav-category-hint">@doc.Category.Name</span>
                            </NavLink>
                        </div>
                    }
                }
                else if (currentMode == "inv")
                {
                    @foreach (var cat in invFavoriteCategories)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"inventory/category/{cat.Id}")">
                                <FolderIcon Color="@GetInvCatColor(cat.Id)" />@cat.Name
                                <span class="nav-category-hint">folder</span>
                            </NavLink>
                        </div>
                    }
                    @foreach (var item in invFavoriteItems)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"inventory?sel={item.Id}")">
                                @item.Title
                                <span class="nav-category-hint">@item.Category?.Name</span>
                            </NavLink>
                        </div>
                    }
                }
                else
                {
                    @foreach (var cat in sopFavoriteCategories)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"sops/category/{cat.Id}")">
                                <FolderIcon Color="@GetSopCatColor(cat.Id)" />@cat.Name
                                <span class="nav-category-hint">folder</span>
                            </NavLink>
                        </div>
                    }
                    @foreach (var doc in sopFavoriteDocuments)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"sops/{doc.Id}")">
                                @doc.Title
                                <span class="nav-category-hint">@doc.Category.Name</span>
                            </NavLink>
                        </div>
                    }
                }

                <hr class="sidebar-divider" />
            }
        }

        @* --- Category tree --- *@
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@homeHref" Match="NavLinkMatch.All">
                    Home
                </NavLink>
            </div>

            @if (currentModeCategories is null)
            {
                @foreach (var w in skeletonWidths)
                {
                    <div class="nav-item px-3">
                        <div class="skeleton-line sidebar-skeleton" style="width:@(w)%;"></div>
                    </div>
                }
            }
            else if (currentMode == "doc")
            {
                @foreach (var category in docCategories!.OrderByDescending(c => IsDocCatPinned(c.Id)).ThenBy(c => c.Name))
                {
                    @RenderDocCategoryTree(category, 0)
                }
            }
            else if (currentMode == "inv")
            {
                @foreach (var category in invCategories!.OrderByDescending(c => IsInvCatPinned(c.Id)).ThenBy(c => c.Name))
                {
                    @RenderInvCategoryTree(category, 0)
                }
            }
            else
            {
                @foreach (var category in sopCategories!.OrderByDescending(c => IsSopCatPinned(c.Id)).ThenBy(c => c.Name))
                {
                    @RenderSopCategoryTree(category, 0)
                }
            }
        </nav>
    }
    }
</div>

<div class="sidebar-footer">
    <a href="/settings" class="sidebar-settings-link" title="Settings">&#9881;</a>
    <span class="sidebar-version">v@(AppVersion)</span>
</div>

@code {
    private static readonly string AppVersion = System.Reflection.Assembly.GetExecutingAssembly()
        .GetName().Version?.ToString(3) ?? "1.0.0";
    private static readonly Random _rng = new();
    private int[] skeletonWidths = Enumerable.Range(0, 16).Select(_ => _rng.Next(65, 96)).ToArray();
    // --- Cached data (read from shared DataCacheService) ---
    private List<SopCategory>? sopCategories;
    private List<SopCategory> sopFavoriteCategories = [];
    private List<SopFile> sopFavoriteDocuments = [];

    private List<DocumentCategory>? docCategories;
    private List<DocumentCategory> docFavoriteCategories = [];
    private List<OfficeDocument> docFavoriteDocuments = [];

    private List<InventoryCategory>? invCategories;
    private List<InventoryCategory> invFavoriteCategories = [];
    private List<InventoryItem> invFavoriteItems = [];
    private List<InventoryItem> invSearchResults = [];

    // --- Per-user preference dictionaries ---
    private Dictionary<int, UserPreference> sopCatPrefs = new();
    private Dictionary<int, UserPreference> docCatPrefs = new();
    private Dictionary<int, UserPreference> invCatPrefs = new();

    private bool IsSopCatFavorited(int id) => sopCatPrefs.TryGetValue(id, out var p) && p.IsFavorited;
    private bool IsSopCatPinned(int id) => sopCatPrefs.TryGetValue(id, out var p) && p.IsPinned;
    private string? GetSopCatColor(int id) => sopCatPrefs.TryGetValue(id, out var p) ? p.Color : null;

    private bool IsDocCatFavorited(int id) => docCatPrefs.TryGetValue(id, out var p) && p.IsFavorited;
    private bool IsDocCatPinned(int id) => docCatPrefs.TryGetValue(id, out var p) && p.IsPinned;
    private string? GetDocCatColor(int id) => docCatPrefs.TryGetValue(id, out var p) ? p.Color : null;

    private bool IsInvCatFavorited(int id) => invCatPrefs.TryGetValue(id, out var p) && p.IsFavorited;
    private bool IsInvCatPinned(int id) => invCatPrefs.TryGetValue(id, out var p) && p.IsPinned;
    private string? GetInvCatColor(int id) => invCatPrefs.TryGetValue(id, out var p) ? p.Color : null;

    // --- Shared state ---
    private HashSet<int> expandedSopCategories = [];
    private HashSet<int> expandedDocCategories = [];
    private HashSet<int> expandedInvCategories = [];
    private string searchQuery = string.Empty;
    private bool isSearching => !string.IsNullOrWhiteSpace(searchQuery);
    private bool favoritesExpanded = true;
    private System.Timers.Timer? debounceTimer;

    private bool _favoritesLoaded;

    private string currentMode
    {
        get
        {
            var uri = Nav.Uri;
            if (uri.Contains("/favorites", StringComparison.OrdinalIgnoreCase)) return "favorites";
            // The results route carries the module it was launched from, so searching out of
            // Documents does not silently swap the sidebar to the SOP tree and strand you there.
            if (uri.Contains("/search", StringComparison.OrdinalIgnoreCase)) return ModeFromQuery(uri);
            if (uri.Contains("/documents", StringComparison.OrdinalIgnoreCase)) return "doc";
            if (uri.Contains("/inventory", StringComparison.OrdinalIgnoreCase)) return "inv";
            return "sop";
        }
    }

    private static string ModeFromQuery(string uri)
    {
        try
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(uri).Query);
            if (query.TryGetValue("from", out var from))
            {
                var value = from.ToString();
                if (value is "doc" or "inv" or "sop") return value;
            }
        }
        catch (UriFormatException) { }
        return "sop";
    }

    private object? currentModeCategories => currentMode switch
    {
        "favorites" => _favoritesLoaded ? (object)true : null,
        "doc" => docCategories,
        "inv" => invCategories,
        _ => sopCategories
    };

    private string searchPlaceholder => currentMode switch
    {
        "inv" => "Search inventory...",
        _ => "Search SOPs and documents..."
    };

    private string homeHref => currentMode switch
    {
        "favorites" => "favorites",
        "doc" => "documents",
        "inv" => "inventory",
        _ => ""
    };

    private bool hasFavorites => currentMode switch
    {
        "favorites" => false,
        "doc" => docFavoriteCategories.Count > 0 || docFavoriteDocuments.Count > 0,
        "inv" => invFavoriteCategories.Count > 0 || invFavoriteItems.Count > 0,
        _ => sopFavoriteCategories.Count > 0 || sopFavoriteDocuments.Count > 0
    };

    private int favoritesCount => currentMode switch
    {
        "favorites" => 0,
        "doc" => docFavoriteCategories.Count + docFavoriteDocuments.Count,
        "inv" => invFavoriteCategories.Count + invFavoriteItems.Count,
        _ => sopFavoriteCategories.Count + sopFavoriteDocuments.Count
    };

    protected override void OnInitialized()
    {
        // Seed from the URL on first render too, not just on navigation: a results page opened
        // directly, bookmarked, or shared would otherwise show an empty box above its own results.
        if (IsOnResults) searchQuery = QueryFromUrl(Nav.Uri);

        Nav.LocationChanged += OnLocationChanged;
        MenuState.OnCategoryModified += OnCategoryModified;
        MenuState.OnChange += StateHasChanged;
        SyncNotify.OnReconciled += OnReconciled;
    }

    // Fired (off the circuit's thread) when the background folder sync changes data.
    // Reuse the existing category-modified refresh path so the sidebar and all open pages update.
    private async Task OnReconciled(SyncScope scope)
    {
        try { await MenuState.NotifyCategoryModified(); }
        catch (ObjectDisposedException) { }
        catch (OperationCanceledException) { }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _ = PreloadAllModesAsync();
        return Task.CompletedTask;
    }

    private CancellationTokenSource _cts = new();

    private async Task PreloadAllModesAsync()
    {
        try
        {
            var mode = currentMode;

            await Task.Run(async () => await LoadModeData(mode), _cts.Token);
            StateHasChanged();

            foreach (var m in new[] { "sop", "doc", "inv" })
            {
                if (m != mode)
                    await Task.Run(async () => await LoadModeData(m), _cts.Token);
            }
        }
        catch (ObjectDisposedException) { }
        catch (OperationCanceledException) { }
    }

    private async Task OnCategoryModified()
    {
        try
        {
            Cache.InvalidateAll();
            _favoritesLoaded = false;
            var mode = currentMode;
            await Task.Run(async () => await LoadModeData(mode), _cts.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (OperationCanceledException) { }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await InvokeAsync(() =>
            {
                // Keep the box populated while the results it produced are on screen —
                // clearing it here would wipe the query the moment our own navigation landed.
                // Opening one of the results, or going anywhere else, resets it.
                if (IsOnResults)
                {
                    // A results URL opened directly, shared, or reloaded must show its query in
                    // the box — otherwise the only control on the page contradicts the screen.
                    searchQuery = QueryFromUrl(Nav.Uri);
                }
                else
                {
                    searchQuery = string.Empty;
                    invSearchResults = [];
                }
                StateHasChanged();
            });

            if (currentModeCategories is null)
            {
                var mode = currentMode;
                await Task.Run(async () => await LoadModeData(mode), _cts.Token);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException) { }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
        MenuState.OnCategoryModified -= OnCategoryModified;
        MenuState.OnChange -= StateHasChanged;
        SyncNotify.OnReconciled -= OnReconciled;
    }

    private void SwitchMode(string mode)
    {
        searchQuery = string.Empty;
        Nav.NavigateTo(mode switch
        {
            "doc" => "/documents",
            "inv" => "/inventory",
            _ => "/"
        });
    }

    private async Task LoadModeData(string mode)
    {
        switch (mode)
        {
            case "favorites":
                sopFavoriteCategories = await Cache.GetSopFavoriteCategoriesAsync();
                sopFavoriteDocuments = await Cache.GetSopFavoriteDocumentsAsync();
                docFavoriteCategories = await Cache.GetDocFavoriteCategoriesAsync();
                docFavoriteDocuments = await Cache.GetDocFavoriteDocumentsAsync();
                invFavoriteCategories = await Cache.GetInvFavoriteCategoriesAsync();
                invFavoriteItems = await Cache.GetInvFavoriteItemsAsync();
                sopCatPrefs = await Cache.GetSopCategoryPrefsAsync();
                docCatPrefs = await Cache.GetDocCategoryPrefsAsync();
                invCatPrefs = await Cache.GetInvCategoryPrefsAsync();
                _favoritesLoaded = true;
                break;
            case "doc":
                docCategories = await Cache.GetDocTreeAsync();
                docFavoriteCategories = await Cache.GetDocFavoriteCategoriesAsync();
                docFavoriteDocuments = await Cache.GetDocFavoriteDocumentsAsync();
                docCatPrefs = await Cache.GetDocCategoryPrefsAsync();
                break;
            case "inv":
                invCategories = await Cache.GetInvTreeAsync();
                invFavoriteCategories = await Cache.GetInvFavoriteCategoriesAsync();
                invFavoriteItems = await Cache.GetInvFavoriteItemsAsync();
                invCatPrefs = await Cache.GetInvCategoryPrefsAsync();
                break;
            default:
                sopCategories = await Cache.GetSopTreeAsync();
                sopFavoriteCategories = await Cache.GetSopFavoriteCategoriesAsync();
                sopFavoriteDocuments = await Cache.GetSopFavoriteDocumentsAsync();
                sopCatPrefs = await Cache.GetSopCategoryPrefsAsync();
                break;
        }
    }

    // --- SOP (files) tree ---

    private bool IsSopExpanded(int id) => expandedSopCategories.Contains(id);

    private void ToggleSopCategory(int id)
    {
        if (!expandedSopCategories.Remove(id))
            expandedSopCategories.Add(id);
    }

    private int GetSopDocCount(SopCategory cat)
    {
        int count = cat.Documents.Count;
        foreach (var child in cat.Children)
            count += GetSopDocCount(child);
        return count;
    }

    private RenderFragment RenderSopCategoryTree(SopCategory category, int depth) => __builder =>
    {
        var paddingLeft = $"{1 + depth * 0.75}rem";
        var docPaddingLeft = $"{1.75 + depth * 0.75}rem";
        var totalCount = GetSopDocCount(category);

        <div class="nav-section" style="padding-left: @paddingLeft;"
             @oncontextmenu="(e) => MenuState.Show(e.ClientX, e.ClientY, category.Id, category.Name, IsSopCatFavorited(category.Id), IsSopCatPinned(category.Id), GetSopCatColor(category.Id), CategoryType.Sop)"
             @oncontextmenu:preventDefault="true">
            <button class="nav-section-toggle" @onclick="() => ToggleSopCategory(category.Id)">
                <span class="toggle-icon">@(IsSopExpanded(category.Id) ? "▾" : "▸")</span>
                <span class="nav-section-title"><FolderIcon Color="@GetSopCatColor(category.Id)" />@category.Name@if (IsSopCatPinned(category.Id)) { <span class="pin-icon" title="Pinned">&#128204;</span> }</span>
                <span class="nav-section-count">@totalCount</span>
            </button>
        </div>

        @if (IsSopExpanded(category.Id))
        {
            @foreach (var child in category.Children.OrderByDescending(c => IsSopCatPinned(c.Id)).ThenBy(c => c.Name))
            {
                @RenderSopCategoryTree(child, depth + 1)
            }

            @foreach (var doc in category.Documents)
            {
                <div class="nav-item" style="padding-left: @docPaddingLeft;">
                    <NavLink class="nav-link" href="@($"sops/{doc.Id}")">
                        @doc.Title
                    </NavLink>
                </div>
            }

            <div class="nav-item" style="padding-left: @docPaddingLeft;">
                <NavLink class="nav-link nav-link-new" href="@($"sops/upload?categoryId={category.Id}")">
                    + Upload
                </NavLink>
            </div>
        }
    };

    // --- Document tree ---

    private bool IsDocExpanded(int id) => expandedDocCategories.Contains(id);

    private void ToggleDocCategory(int id)
    {
        if (!expandedDocCategories.Remove(id))
            expandedDocCategories.Add(id);
    }

    private int GetDocCount(DocumentCategory cat)
    {
        int count = cat.Documents.Count;
        foreach (var child in cat.Children)
            count += GetDocCount(child);
        return count;
    }

    private RenderFragment RenderDocCategoryTree(DocumentCategory category, int depth) => __builder =>
    {
        var paddingLeft = $"{1 + depth * 0.75}rem";
        var docPaddingLeft = $"{1.75 + depth * 0.75}rem";
        var totalCount = GetDocCount(category);

        <div class="nav-section" style="padding-left: @paddingLeft;"
             @oncontextmenu="(e) => MenuState.Show(e.ClientX, e.ClientY, category.Id, category.Name, IsDocCatFavorited(category.Id), IsDocCatPinned(category.Id), GetDocCatColor(category.Id), CategoryType.Document)"
             @oncontextmenu:preventDefault="true">
            <button class="nav-section-toggle" @onclick="() => ToggleDocCategory(category.Id)">
                <span class="toggle-icon">@(IsDocExpanded(category.Id) ? "▾" : "▸")</span>
                <span class="nav-section-title"><FolderIcon Color="@GetDocCatColor(category.Id)" />@category.Name@if (IsDocCatPinned(category.Id)) { <span class="pin-icon" title="Pinned">&#128204;</span> }</span>
                <span class="nav-section-count">@totalCount</span>
            </button>
        </div>

        @if (IsDocExpanded(category.Id))
        {
            @foreach (var child in category.Children.OrderByDescending(c => IsDocCatPinned(c.Id)).ThenBy(c => c.Name))
            {
                @RenderDocCategoryTree(child, depth + 1)
            }

            @foreach (var doc in category.Documents)
            {
                <div class="nav-item" style="padding-left: @docPaddingLeft;">
                    <NavLink class="nav-link" href="@($"documents/{doc.Id}")">
                        @doc.Title
                    </NavLink>
                </div>
            }

            <div class="nav-item" style="padding-left: @docPaddingLeft;">
                <NavLink class="nav-link nav-link-new" href="@($"documents/upload?categoryId={category.Id}")">
                    + Upload
                </NavLink>
            </div>
        }
    };

    // --- Inventory tree ---

    private bool IsInvExpanded(int id) => expandedInvCategories.Contains(id);

    private void ToggleInvCategory(int id)
    {
        if (!expandedInvCategories.Remove(id))
            expandedInvCategories.Add(id);
    }

    private int GetInvItemCount(InventoryCategory cat)
    {
        int count = cat.Items.Count;
        foreach (var child in cat.Children)
            count += GetInvItemCount(child);
        return count;
    }

    private RenderFragment RenderInvCategoryTree(InventoryCategory category, int depth) => __builder =>
    {
        var paddingLeft = $"{1 + depth * 0.75}rem";
        var itemPaddingLeft = $"{1.75 + depth * 0.75}rem";
        var totalCount = GetInvItemCount(category);

        <div class="nav-section" style="padding-left: @paddingLeft;"
             @oncontextmenu="(e) => MenuState.Show(e.ClientX, e.ClientY, category.Id, category.Name, IsInvCatFavorited(category.Id), IsInvCatPinned(category.Id), GetInvCatColor(category.Id), CategoryType.Inventory)"
             @oncontextmenu:preventDefault="true">
            <button class="nav-section-toggle" @onclick="() => ToggleInvCategory(category.Id)">
                <span class="toggle-icon">@(IsInvExpanded(category.Id) ? "▾" : "▸")</span>
                <span class="nav-section-title"><FolderIcon Color="@GetInvCatColor(category.Id)" />@category.Name@if (IsInvCatPinned(category.Id)) { <span class="pin-icon" title="Pinned">&#128204;</span> }</span>
                <span class="nav-section-count">@totalCount</span>
            </button>
        </div>

        @if (IsInvExpanded(category.Id))
        {
            @foreach (var child in category.Children.OrderByDescending(c => IsInvCatPinned(c.Id)).ThenBy(c => c.Name))
            {
                @RenderInvCategoryTree(child, depth + 1)
            }

            @foreach (var item in category.Items)
            {
                <div class="nav-item" style="padding-left: @itemPaddingLeft;">
                    <NavLink class="nav-link" href="@($"inventory?sel={item.Id}")">
                        @item.Title
                    </NavLink>
                </div>
            }

            <div class="nav-item" style="padding-left: @itemPaddingLeft;">
                <NavLink class="nav-link nav-link-new" href="@($"inventory/new?categoryId={category.Id}")">
                    + New Item
                </NavLink>
            </div>
        }
    };

    // --- Search ---

    /// <summary>Whether the main view is currently showing search results.</summary>
    private bool IsOnResults => Nav.Uri.Contains("/search", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Put the current query's results in the main view. Replaces rather than pushes, so typing
    /// a word does not leave a history entry per keystroke to back out through.
    /// </summary>
    private static string QueryFromUrl(string uri)
    {
        try
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(uri).Query);
            return query.TryGetValue("q", out var q) ? q.ToString() : string.Empty;
        }
        catch (UriFormatException) { return string.Empty; }
    }

    private void ShowResults()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        Nav.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}&from={currentMode}", replace: IsOnResults);
    }

    /// <summary>Enter commits immediately rather than waiting out the debounce.</summary>
    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || currentMode == "inv") return;
        debounceTimer?.Stop();
        ShowResults();
    }

    /// <summary>
    /// Runs after every edit to the box, via @bind:after. Deliberately not tied to keyup: the
    /// browser's built-in clear button, pasting with the mouse, and drag-and-drop all change the
    /// value without ever producing a keystroke.
    /// </summary>
    private async Task OnSearchChanged()
    {
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            invSearchResults = [];
            // Clearing the box leaves the results behind and returns you to where you browse.
            if (currentMode != "inv" && IsOnResults) Nav.NavigateTo(homeHref, replace: true);
            return;
        }

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, _) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                if (currentMode == "inv")
                {
                    invSearchResults = await Cache.RunExclusiveAsync(() => InvService.GetItemsAsync(null, null, null, searchQuery));
                }
                else
                {
                    ShowResults();
                }
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }
}
