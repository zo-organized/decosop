@page "/favorites"
@using DecoSOP.Services
@using DecoSOP.Models
@inject UserPreferenceService Prefs
@inject DataCacheService Cache
@inject ContextMenuState MenuState
@implements IDisposable

<PageTitle>Favorites - DecoSOP</PageTitle>

<div class="home-container">
    <h1>&#9733; All Favorites</h1>

    @if (!loaded)
    {
        <SkeletonCards />
    }
    else if (!hasFavorites)
    {
        <p class="text-muted">No favorites yet. Right-click or star any category or document to add it here.</p>
    }
    else
    {
        @if (sopFavCats.Count > 0 || sopFavDocs.Count > 0)
        {
            @FavoriteSection("SOPs", "sops", CategoryType.Sop, nameof(SopCategory), nameof(SopFile),
                sopFavCats, sopFavDocs.Select(d => (d.Id, d.Title, d.FileName, d.FileSize, d.Category.Name)), sopCatPrefs)
        }

        @if (docFavCats.Count > 0 || docFavDocs.Count > 0)
        {
            @FavoriteSection("Documents", "documents", CategoryType.Document, nameof(DocumentCategory), nameof(OfficeDocument),
                docFavCats, docFavDocs.Select(d => (d.Id, d.Title, d.FileName, d.FileSize, d.Category.Name)), docCatPrefs)
        }
    }
</div>

@code {
    private CancellationTokenSource _cts = new();
    private bool loaded;
    private List<SopCategory> sopFavCats = [];
    private List<SopFile> sopFavDocs = [];
    private List<DocumentCategory> docFavCats = [];
    private List<OfficeDocument> docFavDocs = [];
    private bool hasFavorites => sopFavCats.Count > 0 || sopFavDocs.Count > 0
                              || docFavCats.Count > 0 || docFavDocs.Count > 0;

    private Dictionary<int, UserPreference> sopCatPrefs = new();
    private Dictionary<int, UserPreference> docCatPrefs = new();

    private static bool IsPinned(Dictionary<int, UserPreference> prefs, int id) => prefs.TryGetValue(id, out var p) && p.IsPinned;
    private static string? GetColor(Dictionary<int, UserPreference> prefs, int id) => prefs.TryGetValue(id, out var p) ? p.Color : null;

    private RenderFragment FavoriteSection(string header, string prefix, CategoryType type,
        string catEntity, string fileEntity, IEnumerable<ICategoryNode> cats,
        IEnumerable<(int Id, string Title, string FileName, long FileSize, string CatName)> docs,
        Dictionary<int, UserPreference> prefs) => __builder =>
    {
        <div class="favorites-section">
            <h2>@header</h2>
            <div class="category-grid">
                @foreach (var cat in cats)
                {
                    <div class="category-card @(GetColor(prefs, cat.Id) is string c ? $"card-color-{c}" : "")"
                         @oncontextmenu="(e) => MenuState.Show(e.ClientX, e.ClientY, cat.Id, cat.Name, true, IsPinned(prefs, cat.Id), GetColor(prefs, cat.Id), type)"
                         @oncontextmenu:preventDefault="true">
                        <h3>
                            <FolderIcon Color="@GetColor(prefs, cat.Id)" /><a href="@prefix/category/@cat.Id" class="category-heading-link">@cat.Name</a>
                            <button class="btn-star starred" title="Remove from favorites"
                                    @onclick="() => ToggleFavorite(catEntity, cat.Id)">&#9733;</button>
                        </h3>
                    </div>
                }
                @foreach (var doc in docs)
                {
                    <div class="category-card category-card-doc"
                         @oncontextmenu="(e) => MenuState.Show(e.ClientX, e.ClientY, doc.Id, doc.Title, true, false, null, type, ItemKind.Document)"
                         @oncontextmenu:preventDefault="true">
                        <h3>
                            <a href="@prefix/@doc.Id" class="category-heading-link">@doc.Title</a>
                            <span class="file-type-badge badge-@SopFileService.GetFileExtension(doc.FileName).ToLower()">@SopFileService.GetFileExtension(doc.FileName)</span>
                            <button class="btn-star starred" title="Remove from favorites"
                                    @onclick="() => ToggleFavorite(fileEntity, doc.Id)">&#9733;</button>
                        </h3>
                        <span class="text-muted small">@doc.CatName &middot; @SopFileService.FormatFileSize(doc.FileSize)</span>
                    </div>
                }
            </div>
        </div>
    };

    protected override void OnInitialized()
    {
        MenuState.OnCategoryModified += LoadDataAsync;
        MenuState.OnChange += StateHasChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _ = LoadDataAsync();
        return Task.CompletedTask;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            await Task.Run(async () =>
            {
                sopFavCats = await Cache.GetSopFavoriteCategoriesAsync();
                sopFavDocs = await Cache.GetSopFavoriteDocumentsAsync();
                docFavCats = await Cache.GetDocFavoriteCategoriesAsync();
                docFavDocs = await Cache.GetDocFavoriteDocumentsAsync();
                sopCatPrefs = await Cache.GetSopCategoryPrefsAsync();
                docCatPrefs = await Cache.GetDocCategoryPrefsAsync();
                loaded = true;
            }, _cts.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        MenuState.OnCategoryModified -= LoadDataAsync;
        MenuState.OnChange -= StateHasChanged;
    }

    private async Task ToggleFavorite(string entityType, int id)
    {
        await Cache.RunExclusiveAsync(() => Prefs.ToggleFavoriteAsync(entityType, id));
        Cache.InvalidateSopFavorites();
        Cache.InvalidateDocFavorites();
        await LoadDataAsync();
    }
}
