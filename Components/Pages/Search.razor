@page "/search"
@using DecoSOP.Data
@using DecoSOP.Services.Search
@using Microsoft.AspNetCore.WebUtilities
@inject SearchIndexService SearchIndex
@inject NavigationManager Nav
@inject ILogger<Search> Logger
@implements IDisposable

<PageTitle>@(string.IsNullOrWhiteSpace(Query) ? "Search" : $"{Query} - Search") - DecoSOP</PageTitle>

<div class="home-container search-page">
    <h1>@(string.IsNullOrWhiteSpace(Query) ? "Search" : $"“{Query}”")</h1>

    @if (isSearching)
    {
        <p class="lead text-muted">Searching…</p>
    }
    else if (string.IsNullOrWhiteSpace(Query))
    {
        <p class="lead">Type a subject in the search box on the left — every SOP or document that discusses it appears here.</p>
        @if (stats is not null && stats.Total > 0 && stats.PercentComplete < 99.5)
        {
            <div class="alert alert-info search-building">
                Still reading your documents — <strong>@stats.Done.ToString("N0")</strong> of
                <strong>@stats.Total.ToString("N0")</strong> files indexed
                (@stats.PercentComplete.ToString("F0")%). Search works now and gets more complete as it finishes.
            </div>
        }
    }
    else if (searchError is not null)
    {
        <p class="lead">Search could not run.</p>
        <div class="alert alert-warning">
            <p class="mb-1">The search index could not be read just now.</p>
            <p class="mb-0 small text-muted">
                If this persists, rebuild the index from <a href="/settings">Settings</a>.
                Browsing the folders on the left still works.
            </p>
        </div>
    }
    else if (results is null || results.TotalCount == 0)
    {
        <p class="lead">No results for <strong>@Query</strong>@(HasFilters ? " with these filters" : "").</p>
        @if (HasFilters)
        {
            @* Without this the filter rows are a dead end: every chip reads 0, including the
               one that would widen the search again. *@
            <p><button class="btn btn-sm btn-outline-primary" @onclick="ClearFilters">Clear filters and search everything</button></p>
        }
        @if (IsIndexBuilding)
        {
            <div class="alert alert-info search-building">
                Still reading your documents — <strong>@stats!.Done.ToString("N0")</strong> of
                <strong>@stats!.Total.ToString("N0")</strong> files indexed
                (@stats!.PercentComplete.ToString("F0")%). More results will appear as it finishes.
            </div>
        }

        <p class="text-muted">Try fewer words, or a different term. Scanned documents are searchable by their
            title until text recognition has run over them.</p>
    }
    else
    {
        <p class="lead">
            <strong>@results.TotalCount.ToString("N0")</strong> result@(results.TotalCount == 1 ? "" : "s")
            for <strong>@Query</strong>
            @if (results.IsBroadened)
            {
                <span class="text-muted small"> — no document contained all of those words, so these match some of them.</span>
            }
        </p>

        @if (IsIndexBuilding)
        {
            <div class="alert alert-info search-building">
                Still reading your documents — <strong>@stats!.Done.ToString("N0")</strong> of
                <strong>@stats!.Total.ToString("N0")</strong> files indexed
                (@stats!.PercentComplete.ToString("F0")%). More results will appear as it finishes.
            </div>
        }

        @* --- Filters --- *@
        @if (results.CountsByModule.Count > 1 || results.CountsByExtension.Count > 1 || Module is not null || Ext is not null)
        {
            <div class="search-filters">
                @if (results.CountsByModule.Count > 1 || Module is not null)
                {
                    <div class="filter-group">
                        <span class="filter-label">Where</span>
                        <button class="filter-chip @(Module is null ? "active" : "")" @onclick="() => SetModuleFilter(null)">All</button>
                        @foreach (var m in results.CountsByModule.OrderByDescending(k => k.Value))
                        {
                            <button class="filter-chip @(Module == m.Key ? "active" : "")"
                                    @onclick="() => SetModuleFilter(m.Key)">
                                @ModuleLabel(m.Key) <span class="filter-count">@m.Value</span>
                            </button>
                        }
                    </div>
                }

                @if (results.CountsByExtension.Count > 1 || Ext is not null)
                {
                    <div class="filter-group">
                        <span class="filter-label">Type</span>
                        <button class="filter-chip @(Ext is null ? "active" : "")" @onclick="() => SetExtFilter(null)">All</button>
                        @foreach (var e in results.CountsByExtension.OrderByDescending(k => k.Value).Take(8))
                        {
                            <button class="filter-chip @(Ext == e.Key ? "active" : "")"
                                    @onclick="() => SetExtFilter(e.Key)">
                                @e.Key.ToUpperInvariant() <span class="filter-count">@e.Value</span>
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @* --- Results --- *@
        <div class="search-results">
            @foreach (var hit in results.Hits)
            {
                <div class="search-hit">
                    <div class="search-hit-head">
                        <FileTypeIcon FileName="@hit.FileName" />
                        <a class="search-hit-title" href="@HitUrl(hit)">@hit.Title</a>
                        <span class="search-hit-ext">@hit.Extension.ToUpperInvariant()</span>
                        <span class="search-hit-module">@ModuleLabel(hit.Module)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(hit.CategoryPath))
                    {
                        <div class="search-hit-path">@hit.CategoryPath</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(hit.SnippetHtml))
                    {
                        <div class="search-hit-snippet">@((MarkupString)hit.SnippetHtml)</div>
                    }
                    else
                    {
                        <div class="search-hit-snippet text-muted">
                            Matched on its title or folder.@(IsScanKind(hit.Extension) ? " This file is a scan — its text isn't readable yet." : "")
                        </div>
                    }
                </div>
            }
        </div>

        @if (RequestedPage > TotalPages)
        {
            <p class="text-muted small">There is no page @RequestedPage — showing the last page instead.</p>
        }

        @if (results.TotalCount > PageSize)
        {
            <div class="search-paging">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(Page <= 1)" @onclick="() => GoToPage(Page - 1)">Previous</button>
                <span class="text-muted small">Page @Page of @TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(Page >= TotalPages)" @onclick="() => GoToPage(Page + 1)">Next</button>
            </div>
        }
    }
</div>

@code {
    private const int PageSize = 25;

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "module")] public string? Module { get; set; }
    [SupplyParameterFromQuery(Name = "ext")] public string? Ext { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    // Taken as a string, not an int. Bound as int?, anything non-numeric in the URL throws
    // during parameter binding and takes the whole page down with "Something went wrong" —
    // and a URL is the easiest thing in the world to mistype or truncate.
    [SupplyParameterFromQuery(Name = "page")] public string? PageParam { get; set; }

    private int RequestedPage =>
        int.TryParse(PageParam, out var p) && p > 0 ? p : 1;

    private int Page => results is null ? RequestedPage : Math.Clamp(RequestedPage, 1, TotalPages);

    private int TotalPages => results is null ? 1 : Math.Max(1, (int)Math.Ceiling(results.TotalCount / (double)PageSize));

    /// <summary>
    /// True while the index is still filling. Shown on the results and no-results screens too,
    /// not just the empty one — a thin result set during a first build is exactly when someone
    /// needs to be told the library is only part-read.
    /// </summary>
    private bool IsIndexBuilding => stats is not null && stats.Total > 0 && stats.PercentComplete < 99.5;

    private bool HasFilters => !string.IsNullOrEmpty(Module) || !string.IsNullOrEmpty(Ext);

    private SearchResults? results;
    private IndexStats? stats;
    private bool isSearching;
    private string? searchError;
    private CancellationTokenSource _cts = new();

    // Guards against an older, slower query overwriting a newer one's results.
    private int _requestSeq;

    protected override async Task OnParametersSetAsync()
    {
        await RunSearchAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatsAsync();
    }

    private async Task RefreshStatsAsync()
    {
        try { stats = await SearchIndex.GetStatsAsync(_cts.Token); }
        catch { stats = null; /* index not ready yet; the page still works */ }
    }

    private async Task RunSearchAsync()
    {
        searchError = null;

        if (string.IsNullOrWhiteSpace(Query))
        {
            results = null;
            await RefreshStatsAsync();   // so the build banner reflects reality, not page-load time
            return;
        }

        var seq = ++_requestSeq;
        isSearching = true;
        await RefreshStatsAsync();   // so the build banner reflects now, not page-load time
        try
        {
            var found = await SearchIndex.SearchAsync(Query, Module, Ext,
                skip: (RequestedPage - 1) * PageSize, take: PageSize, ct: _cts.Token);

            if (seq != _requestSeq) return;   // a newer query already answered

            // An out-of-range page would otherwise report a result count with no rows under it.
            // Re-ask for the last real page instead of showing an empty list.
            var lastPage = Math.Max(1, (int)Math.Ceiling(found.TotalCount / (double)PageSize));
            if (found.Hits.Count == 0 && found.TotalCount > 0 && RequestedPage > lastPage)
            {
                found = await SearchIndex.SearchAsync(Query, Module, Ext,
                    skip: (lastPage - 1) * PageSize, take: PageSize, ct: _cts.Token);
                if (seq != _requestSeq) return;
            }

            results = found;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (seq != _requestSeq) return;
            // Reporting a broken or locked index as "no results" sends people hunting for a
            // document that is sitting right there. Say what actually happened.
            Logger.LogError(ex, "Search failed for query {Query}", Query);
            results = null;
            searchError = ex.Message;
        }
        finally
        {
            if (seq == _requestSeq) isSearching = false;
        }
    }

    // Each facet is set independently. The previous single method could not tell "clear the
    // module facet" from "clear both", so either All chip wiped the other row's selection too.
    private void SetModuleFilter(string? module) => Navigate(Query ?? string.Empty, module, Ext, 1);

    private void SetExtFilter(string? ext) => Navigate(Query ?? string.Empty, Module, ext, 1);

    private void ClearFilters() => Navigate(Query ?? string.Empty, null, null, 1);

    private void GoToPage(int page) => Navigate(Query ?? string.Empty, Module, Ext, page);

    private void Navigate(string q, string? module, string? ext, int page)
    {
        var query = new Dictionary<string, object?> { ["q"] = string.IsNullOrWhiteSpace(q) ? null : q };
        if (!string.IsNullOrEmpty(module)) query["module"] = module;
        if (!string.IsNullOrEmpty(ext)) query["ext"] = ext;
        if (!string.IsNullOrEmpty(From)) query["from"] = From;   // keep the sidebar's module
        if (page > 1) query["page"] = page;

        // Paging and filtering are deliberate steps, so they push history: Back should undo a
        // filter or step back a page rather than leaving the results entirely.
        Nav.NavigateTo(Nav.GetUriWithQueryParameters("/search", query));
    }

    /// <summary>Carry the query into the viewer so it can highlight what matched.</summary>
    private string HitUrl(SearchHit hit)
        => string.IsNullOrWhiteSpace(Query) ? hit.Url : $"{hit.Url}?q={Uri.EscapeDataString(Query)}";

    private static string ModuleLabel(string module)
        => module == SearchDb.ModuleDoc ? "Documents" : "SOPs";

    private static bool IsScanKind(string ext)
        => ext is "pdf" or "jpg" or "jpeg" or "png" or "tif" or "tiff";

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
