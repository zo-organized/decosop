@page "/settings"
@using DecoSOP.Models
@using DecoSOP.Services
@using DecoSOP.Services.Users
@inject DatabaseMaintenanceService Maintenance
@inject AppUserService Users
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UpdateService UpdateService
@inject Microsoft.Extensions.Options.IOptions<FolderSyncOptions> SyncOptions
@inject FolderSyncBackgroundService SyncService
@inject DecoSOP.Services.Search.SearchIndexService SearchIndex
@inject DecoSOP.Services.Search.SearchIndexBackgroundService Indexer
@implements IDisposable

<PageTitle>Settings - DecoSOP</PageTitle>

<div class="settings-container">
    <h1>Settings</h1>

    <div class="settings-section">
        <h2>Document Sync</h2>
        <div class="doc-meta">
            <div class="doc-meta-row">
                <span class="doc-meta-label">Status</span>
                <span>@(sync.Enabled ? "Enabled — indexing the folders below" : "Disabled")</span>
            </div>
            <div class="doc-meta-row">
                <span class="doc-meta-label">SOP folder</span>
                <span>@(string.IsNullOrWhiteSpace(sync.Sop.Root) ? "(not set)" : sync.Sop.Root)</span>
            </div>
            <div class="doc-meta-row">
                <span class="doc-meta-label">Documents folder</span>
                <span>@(string.IsNullOrWhiteSpace(sync.Doc.Root) ? "(not set)" : sync.Doc.Root)</span>
            </div>
            <div class="doc-meta-row">
                <span class="doc-meta-label">"Open in Office" base</span>
                <span>@(HasOpenBase ? "Configured (SharePoint / share)" : "Local path (same machine only)")</span>
            </div>
            <div class="doc-meta-row">
                <span class="doc-meta-label">Last synced</span>
                <span>@LastSyncedText</span>
            </div>
        </div>
        <p class="text-muted small mt-2">
            These folders are the source of truth — DecoSOP indexes them automatically and reflects
            edits (Word/Excel, Replace) on their own. Run the "Configure Document Sync" tool on the
            server to change them.
        </p>
        @if (sync.Enabled)
        {
            <div class="d-flex align-items-center gap-2 mt-2">
                <button class="btn btn-sm btn-outline-primary" @onclick="SyncNow" disabled="@isSyncing">
                    @(isSyncing ? "Syncing..." : "Sync now")
                </button>
                @if (!string.IsNullOrEmpty(syncMessage))
                {
                    <span class="text-muted small">@syncMessage</span>
                }
            </div>
        }
    </div>

    <div class="settings-section">
        <h2>People</h2>
        <p class="text-muted small">
            Each person picks their name at the top right; their favorites, pins, folder colours and
            lists then follow them to any PC. There are no passwords.
        </p>
        @if (people.Count == 0)
        {
            <p class="text-muted small">Nobody has added their name yet.</p>
        }
        else
        {
            <div class="doc-meta">
                @foreach (var person in people)
                {
                    <div class="doc-meta-row align-items-center">
                        <span class="doc-meta-label">@person.Name</span>
                        <span class="ms-auto">
                            <button class="btn btn-sm btn-link py-0" @onclick="() => RenamePerson(person)">Rename</button>
                            <button class="btn btn-sm btn-link py-0 text-danger" @onclick="() => DeletePerson(person)">Remove</button>
                        </span>
                    </div>
                }
            </div>
        }
        @if (peopleMessage is not null)
        {
            <div class="alert alert-warning py-1 mt-2 small">@peopleMessage</div>
        }
    </div>

    <div class="settings-section">
        <h2>Database Statistics</h2>
        @if (stats is not null)
        {
            <div class="doc-meta">
                <div class="doc-meta-row">
                    <span class="doc-meta-label">DB Size</span>
                    <span>@stats.FileSize</span>
                </div>
                <div class="doc-meta-row">
                    <span class="doc-meta-label">SOP Categories</span>
                    <span>@stats.SopFolders</span>
                </div>
                <div class="doc-meta-row">
                    <span class="doc-meta-label">SOP Files</span>
                    <span>@stats.SopFiles</span>
                </div>
                <div class="doc-meta-row">
                    <span class="doc-meta-label">Doc Categories</span>
                    <span>@stats.DocFolders</span>
                </div>
                <div class="doc-meta-row">
                    <span class="doc-meta-label">Documents</span>
                    <span>@stats.Documents</span>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted">Loading...</p>
        }
    </div>

    <div class="settings-section">
        <h2>Search Index</h2>
        <p class="text-muted small">
            Full-text search reads the contents of every document. The index lives in its own file
            and is rebuilt from scratch whenever it needs to be, so it is never part of a backup.
        </p>

        @if (indexStats is null)
        {
            <p class="text-muted">Loading...</p>
        }
        else if (indexStats.Total == 0)
        {
            <p class="text-muted">Nothing indexed yet. Indexing starts shortly after the app does.</p>
        }
        else
        {
            @if (Indexer.IsIndexing)
            {
                <div class="alert alert-info py-2">
                    Indexing now — @Indexer.QueuedDone.ToString("N0") of @Indexer.QueuedTotal.ToString("N0") files in this pass.
                    Search works while this runs.
                </div>
            }

            <div class="doc-meta">
                <div class="doc-meta-row">
                    <span class="doc-meta-label">Searchable</span>
                    <span>@indexStats.Indexed.ToString("N0") of @indexStats.Total.ToString("N0") files (@indexStats.PercentComplete.ToString("F0")% processed)</span>
                </div>
                <div class="doc-meta-row">
                    <span class="doc-meta-label">Indexed text</span>
                    <span>@FormatChars(indexStats.TotalChars)</span>
                </div>
                <div class="doc-meta-row">
                    <span class="doc-meta-label">No readable text</span>
                    <span>@indexStats.Empty.ToString("N0") <span class="text-muted small">(scans and photos — found by title only)</span></span>
                </div>
                <div class="doc-meta-row">
                    <span class="doc-meta-label">Unsupported</span>
                    <span>@indexStats.Skipped.ToString("N0")</span>
                </div>
                @if (indexStats.Missing > 0)
                {
                    <div class="doc-meta-row">
                        <span class="doc-meta-label">Not found on disk</span>
                        <span class="text-danger">
                            @indexStats.Missing.ToString("N0")
                            <span class="text-muted small">— listed in the library but the file is missing. Check the folder roots above.</span>
                        </span>
                    </div>
                }
                <div class="doc-meta-row">
                    <span class="doc-meta-label">Failed</span>
                    <span>@indexStats.Failed.ToString("N0")</span>
                </div>
                @if (indexStats.LastIndexedUtc is DateTime last)
                {
                    <div class="doc-meta-row">
                        <span class="doc-meta-label">Last updated</span>
                        <span>@last.ToLocalTime().ToString("g")</span>
                    </div>
                }
            </div>

            @if (failures.Count > 0)
            {
                <details class="mt-2">
                    <summary class="small text-muted">Show @failures.Count file@(failures.Count == 1 ? "" : "s") that could not be read</summary>
                    <ul class="small text-muted mt-2">
                        @foreach (var f in failures)
                        {
                            <li><code>@f.Path</code> — @f.Error</li>
                        }
                    </ul>
                </details>
            }

            <div class="mt-3 d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshIndexStats">Refresh</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="RebuildIndex" disabled="@isRebuilding">
                    @(isRebuilding ? "Rebuilding..." : "Rebuild index")
                </button>
                <span class="text-muted small">Rebuilding re-reads every document. It runs in the background.</span>
            </div>
            @if (rebuildMessage is not null)
            {
                <div class="mt-2 small @(rebuildMessage.StartsWith("Rebuild failed") ? "text-danger" : "text-success")">@rebuildMessage</div>
            }
        }
    </div>

    <div class="settings-section">
        <h2>Database Backup</h2>
        <p class="text-muted small">Download a copy of the database. Your documents live in the synced folder — this backs up the category index and each user's favorites, pins, and colors.</p>
        <a href="/api/settings/export-db" class="btn btn-sm btn-primary" download="decosop-backup.db">Export Database</a>
    </div>

    <div class="settings-section">
        <h2>Online Binder Backup</h2>
        <p class="text-muted small">
            Download a copy of every <strong>ONLINE</strong> page, folder and earlier version. Unlike LOCAL files, these
            pages exist only on this server — they are not in OneDrive — so keep a recent copy somewhere safe.
        </p>
        <a href="/api/settings/export-online-db" class="btn btn-sm btn-primary">Export Online Binder</a>
    </div>

    <div class="settings-section">
        <h2>Database Restore</h2>
        <p class="text-muted small">Replace the database from a backup (restores favorites, pins, and colors). Categories and documents are re-derived from the synced folder on restart.</p>

        @if (!string.IsNullOrEmpty(importMessage))
        {
            <div class="alert @(importSuccess ? "alert-success" : "alert-danger") mt-2">@importMessage</div>
        }

        <InputFile OnChange="OnImportFileSelected" accept=".db" class="form-control form-control-sm" style="max-width:400px;" />

        @if (importFile is not null)
        {
            <div class="mt-2">
                <button class="btn btn-sm btn-danger" @onclick="ImportDatabase" disabled="@isImporting">
                    @(isImporting ? "Importing..." : "Replace Database")
                </button>
                <span class="text-muted small ms-2">@importFile.Name (@SopFileService.FormatFileSize(importFile.Size))</span>
            </div>
        }
    </div>

    <div class="settings-section">
        <h2>Updates</h2>
        <div class="doc-meta">
            <div class="doc-meta-row">
                <span class="doc-meta-label">Current Version</span>
                <span>@appVersion</span>
            </div>
            <div class="doc-meta-row">
                <span class="doc-meta-label">Status</span>
                <span>
                    @if (UpdateService.IsInstalling)
                    {
                        <text>Installing update, service will restart shortly...</text>
                    }
                    else if (UpdateService.IsDownloading)
                    {
                        <text>Downloading... (@((UpdateService.DownloadProgress * 100).ToString("F0"))%)</text>
                    }
                    else if (!string.IsNullOrEmpty(UpdateService.UpdateError))
                    {
                        <span class="text-danger">@UpdateService.UpdateError</span>
                    }
                    else if (UpdateService.UpdateAvailable)
                    {
                        <text>Version </text><strong>@UpdateService.NewVersion</strong><text> is available</text>
                    }
                    else
                    {
                        <text>Up to date</text>
                    }
                </span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-2 mb-3">
            @if (UpdateService.UpdateAvailable && !UpdateService.IsDownloading && !UpdateService.IsInstalling)
            {
                <button class="btn btn-sm btn-primary" @onclick="InstallUpdate">Install Update</button>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="CheckForUpdates" disabled="@isChecking">
                @(isChecking ? "Checking..." : "Check for Updates")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(updateMessage))
        {
            <div class="alert @(updateMessageSuccess ? "alert-success" : "alert-info") mt-2">@updateMessage</div>
        }

        <hr />
        <h3 class="h6">Automatic Updates</h3>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="autoUpdateCheck" checked="@autoUpdateEnabled" @onchange="ToggleAutoUpdate" />
            <label class="form-check-label" for="autoUpdateCheck">Enable update checks</label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="autoInstallCheck" checked="@autoInstallEnabled"
                   @onchange="ToggleAutoInstall" disabled="@(!autoUpdateEnabled)" />
            <label class="form-check-label" for="autoInstallCheck">Automatically install updates</label>
        </div>
        @if (autoInstallEnabled && autoUpdateEnabled)
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                <label for="autoInstallTime" class="small">Install time:</label>
                <input type="time" id="autoInstallTime" class="form-control form-control-sm" style="width:140px;"
                       value="@autoInstallTime" @onchange="UpdateInstallTime" />
            </div>
            <p class="text-muted small">Updates will be downloaded and installed automatically around this time.</p>
        }
    </div>

    <div class="settings-section">
        <h2>About</h2>
        <div class="doc-meta">
            <div class="doc-meta-row">
                <span class="doc-meta-label">Author</span>
                <span>Tyler Sweeney</span>
            </div>
            <div class="doc-meta-row">
                <span class="doc-meta-label">Version</span>
                <span>@appVersion</span>
            </div>
            <div class="doc-meta-row">
                <span class="doc-meta-label">Runtime</span>
                <span>.NET @Environment.Version</span>
            </div>
            <div class="doc-meta-row">
                <span class="doc-meta-label">Platform</span>
                <span>@System.Runtime.InteropServices.RuntimeInformation.OSDescription</span>
            </div>
        </div>
    </div>
</div>

@code {
    // --- Search index panel ---
    private DecoSOP.Services.Search.IndexStats? indexStats;
    private List<(string Path, string Error)> failures = [];
    private bool isRebuilding;

    private async Task RefreshIndexStats()
    {
        try
        {
            indexStats = await SearchIndex.GetStatsAsync();
            var found = await SearchIndex.GetFailuresAsync(50);
            failures = found.Select(f => (f.Path, f.Error)).ToList();
        }
        catch
        {
            // The index file may not exist yet on a first run; the panel just stays empty.
            indexStats = null;
        }
    }

    private string? rebuildMessage;

    private async Task RebuildIndex()
    {
        isRebuilding = true;
        rebuildMessage = null;
        try
        {
            // Goes through the indexer so it cannot drop the tables while a pass is writing.
            await Indexer.RebuildAsync();
            await RefreshIndexStats();
            rebuildMessage = "Index cleared. Rebuilding in the background — search works while it runs.";
        }
        catch (Exception ex)
        {
            // A locked or read-only index file used to fail silently, leaving the button looking
            // like it had worked.
            rebuildMessage = $"Rebuild failed: {ex.Message}";
        }
        finally
        {
            isRebuilding = false;
        }
    }

    private static string FormatChars(long chars)
    {
        if (chars < 1024) return $"{chars} characters";
        if (chars < 1024 * 1024) return $"{chars / 1024.0:F0} KB";
        return $"{chars / (1024.0 * 1024.0):F1} MB";
    }

    private DatabaseMaintenanceService.Stats? stats;
    private IBrowserFile? importFile;
    private string importMessage = "";
    private bool importSuccess;
    private bool isImporting;

    // Update settings state
    private bool isChecking;
    private string updateMessage = "";
    private bool updateMessageSuccess;
    private bool autoUpdateEnabled;
    private bool autoInstallEnabled;
    private string autoInstallTime = "02:00";

    private static readonly string appVersion = System.Reflection.Assembly.GetExecutingAssembly()
        .GetName().Version?.ToString(3) ?? "1.0.0";

    private FolderSyncOptions sync => SyncOptions.Value;
    private bool HasOpenBase => !string.IsNullOrWhiteSpace(sync.Sop.OpenBase) || !string.IsNullOrWhiteSpace(sync.Doc.OpenBase);

    private bool isSyncing;
    private string? syncMessage;

    private string LastSyncedText => SyncService.LastSyncUtc is DateTime t
        ? t.ToLocalTime().ToString("g")
        : "Never";

    private async Task SyncNow()
    {
        isSyncing = true;
        syncMessage = null;
        StateHasChanged();
        try
        {
            await SyncService.SyncNowAsync();
            await LoadStats();
            var sop = SyncService.LastSopResult;
            var doc = SyncService.LastDocResult;
            syncMessage = $"Done — SOPs +{sop.Added} ~{sop.Updated} -{sop.Removed}, Docs +{doc.Added} ~{doc.Updated} -{doc.Removed}.";
        }
        catch (Exception ex)
        {
            syncMessage = $"Sync failed: {ex.Message}";
        }
        finally
        {
            isSyncing = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        autoUpdateEnabled = UpdateService.Enabled;
        autoInstallEnabled = UpdateService.AutoInstall;
        autoInstallTime = UpdateService.AutoInstallTime;
        UpdateService.OnUpdateChecked += OnUpdateChecked;
        await LoadStats();
        await RefreshIndexStats();
        people = await Users.GetAllAsync();
    }

    private List<AppUser> people = [];
    private string? peopleMessage;

    private async Task RenamePerson(AppUser person)
    {
        var name = await JS.InvokeAsync<string?>("prompt", "Rename:", person.Name);
        if (string.IsNullOrWhiteSpace(name)) return;
        await RunPeople(() => Users.RenameAsync(person.Id, name));
    }

    private async Task DeletePerson(AppUser person)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Remove {person.Name}? Their favorites, pins, folder colours and lists are deleted too. Documents are not affected.")) return;
        await RunPeople(() => Users.DeleteAsync(person.Id));
    }

    private async Task RunPeople(Func<Task> action)
    {
        try
        {
            peopleMessage = null;
            await action();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            peopleMessage = ex.Message;
        }
        people = await Users.GetAllAsync();
    }

    private void OnUpdateChecked()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CheckForUpdates()
    {
        isChecking = true;
        updateMessage = "";
        StateHasChanged();

        await UpdateService.CheckForUpdateAsync();

        isChecking = false;
        if (!UpdateService.UpdateAvailable)
        {
            updateMessage = "You're running the latest version.";
            updateMessageSuccess = true;
        }
    }

    private async Task InstallUpdate()
    {
        updateMessage = "";
        await UpdateService.DownloadAndInstallAsync();
    }

    private void ToggleAutoUpdate(ChangeEventArgs e)
    {
        autoUpdateEnabled = (bool)(e.Value ?? false);
        UpdateService.EnableChecks(autoUpdateEnabled);
        if (!autoUpdateEnabled)
            autoInstallEnabled = false;
    }

    private void ToggleAutoInstall(ChangeEventArgs e)
    {
        autoInstallEnabled = (bool)(e.Value ?? false);
        UpdateService.SetAutoInstall(autoInstallEnabled, autoInstallTime);
    }

    private void UpdateInstallTime(ChangeEventArgs e)
    {
        autoInstallTime = e.Value?.ToString() ?? "02:00";
        UpdateService.SetAutoInstall(autoInstallEnabled, autoInstallTime);
    }

    public void Dispose()
    {
        UpdateService.OnUpdateChecked -= OnUpdateChecked;
    }

    private async Task LoadStats() => stats = await Maintenance.GetStatsAsync();

    private void OnImportFileSelected(InputFileChangeEventArgs e)
    {
        importFile = e.File;
        importMessage = "";
    }

    private async Task ImportDatabase()
    {
        if (importFile is null) return;

        isImporting = true;
        importMessage = "";

        try
        {
            using var stream = importFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            var result = await Maintenance.ReplaceDatabaseAsync(stream);
            importMessage = result.Message;
            importSuccess = result.Success;
        }
        catch (Exception ex)
        {
            importMessage = $"Import failed: {ex.Message}";
            importSuccess = false;
        }
        finally
        {
            isImporting = false;
        }
    }
}
